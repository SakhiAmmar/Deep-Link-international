# Cloudflare R2 Configuration
# Add these to your .env.local file

# Your Cloudflare R2 bucket public URL
# Get this from: Cloudflare R2 Dashboard > Bucket Settings > Public URL
# Format: https://pub-[random-id].r2.dev
NEXT_PUBLIC_R2_BUCKET_URL=https://pub-84133523cf2e46d48181cea0a18cb13a.r2.dev

# Optional: R2 API credentials for programmatic uploads
# Get these from: Cloudflare Dashboard > R2 > API Token
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your-bucket-name
R2_ACCOUNT_ID=your_account_id
